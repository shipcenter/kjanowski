# Wzór pliku .env dla integracji panelu franczyzy ShipCenter.
# Skopiuj do pliku .env TYLKO na serwerze / komputerze, na którym działa skrypt integracji,
# i tam wpisz wartości. Plik .env jest w .gitignore – nie trafia do repozytorium.
# Nie wklejaj tych danych do czatu.
#
# Dla rzeczy uruchamianych przez Claude w chmurze (np. analiza lokalizacji z Map Google)
# klucze wpisuje się w bezpiecznym formularzu Claude (ustawienia środowiska → sekrety),
# a nie w tym pliku – Claude nie widzi ich wartości.

# --- Skrzynka franczyza@shipcenter.pl (IMAP) – import zapytań franczyza / Ship Point ---
IMAP_HOST=shipcenter.pl
IMAP_PORT=143
IMAP_SECURITY=STARTTLS
IMAP_USER=franczyza@shipcenter.pl
IMAP_PASSWORD=
# Serwer ma wyjątek certyfikatu (Thunderbird) – docelowo poprawny certyfikat TLS dla shipcenter.pl
IMAP_FOLDER=INBOX
IMAP_SUBJECT_FRANCZYZA=ZAPYTANIE FRANCZYZOWE
IMAP_SUBJECT_SHIPPOINT=zapytanie ShipPoint

# --- SMSAPI.pl – SMS z podziękowaniem po pierwszej rozmowie ---
SMSAPI_TOKEN=
SMSAPI_SENDER=ShipCenter
# 1 = tryb testowy (SMS nie wychodzi), 0 = wysyłka
SMSAPI_TEST=1

# --- Przypomnienia e-mail dla opiekunów (SMTP) ---
SMTP_HOST=shipcenter.pl
SMTP_PORT=587
SMTP_USER=franczyza@shipcenter.pl
SMTP_PASSWORD=
REMINDER_HOUR=7:30

# --- Google Maps (Places API) – automatyczna analiza lokalizacji i konkurencji ---
GOOGLE_MAPS_API_KEY=

# --- Google Ads – wydatki i konwersje kampanii franczyzowej ---
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CAMPAIGN_NAME=
# Arkusz Google, do którego skrypt Google Ads zapisuje dzienne dane (ID z adresu arkusza)
GOOGLE_ADS_SHEET_ID=
