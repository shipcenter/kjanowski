# Mostek pocztowy panelu franczyzy – skopiuj do pliku .env i uzupełnij.
# Pliku .env NIE wrzucaj do repozytorium (jest w .gitignore).

# Adres, na którym nasłuchuje mostek (Apache przekazuje do niego ruch z https://mcp.shipcenter.pl)
HOST=127.0.0.1
PORT=8787

# Tajny fragment adresu konektora: https://mcp.shipcenter.pl/mcp/<MCP_SECRET>
# Wygeneruj: openssl rand -hex 32   (min. 32 znaki)
MCP_SECRET=

# Skrzynka franczyza@shipcenter.pl – odbiór (IMAP, STARTTLS na porcie 143)
IMAP_HOST=shipcenter.pl
IMAP_PORT=143
IMAP_SECURE=false
IMAP_USER=franczyza@shipcenter.pl
IMAP_PASS=

# Wysyłka (SMTP) – dane jak w Thunderbirdzie: Ustawienia kont → Serwer poczty wychodzącej
SMTP_HOST=shipcenter.pl
SMTP_PORT=587
# true dla portu 465 (SSL), false dla 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=franczyza@shipcenter.pl
SMTP_PASS=

# Nadawca wszystkich maili z panelu
MAIL_FROM=franczyza@shipcenter.pl
MAIL_FROM_NAME=ShipCenter – Franczyza

# Folder „Wysłane” na serwerze (puste = wykryj automatycznie, np. INBOX.Sent)
SENT_FOLDER=

# Sprawdzanie certyfikatu serwera poczty (zostaw true; false tylko gdy certyfikat nie pasuje do nazwy hosta)
TLS_REJECT_UNAUTHORIZED=true

# Limit wysyłki z panelu (ochrona przed nadużyciem)
MAX_SEND_PER_HOUR=80
