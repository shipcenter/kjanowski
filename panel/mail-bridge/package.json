{
  "name": "shipcenter-poczta-mcp",
  "version": "1.0.0",
  "description": "Mostek pocztowy panelu franczyzy ShipCenter: import zgłoszeń z franczyza@shipcenter.pl i wysyłka maili z firmową stopką (serwer MCP dla konektora claude.ai)",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "check": "node --env-file=.env src/check.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "imapflow": "2.11.0",
    "mailparser": "3.14.3",
    "nodemailer": "10.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "smtp-server": "3.21.4"
  }
}
